# 复制为本地环境变量或导出后再启动后端（application.yml 已支持）
DB_USER=root
DB_PWD=change-me

# ----------------------------------------------------
# 支付宝沙箱环境配置（可选，已支持 Alipay EasySDK 官方插件）
# 如不配置或 ALIPAY_ENABLED=false，系统自动降级为「极速演示模拟通道」，离线答辩 100% 顺畅。
# ----------------------------------------------------
ALIPAY_ENABLED=false
ALIPAY_APP_ID=90210001xxxxxxxx
# 应用私钥 (PKCS8 格式，需去除首尾换行，单行填入或通过配置文件引入)
ALIPAY_PRIVATE_KEY=MIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...
# 支付宝公钥 (在支付宝开放平台沙箱应用中换取)
ALIPAY_PUBLIC_KEY=MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA...
# 异步回调地址（生产/公网演示可用 cpolar / natapp 免费内网穿透生成，本地可留空）
ALIPAY_NOTIFY_URL=http://your-tunnel-domain.cpolar.cn/api/utility/pay/alipay-notify
# 同步回跳页面地址（学生端页面）
ALIPAY_RETURN_URL=http://localhost:5174
