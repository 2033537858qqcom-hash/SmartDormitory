/* Design tokens are aligned with frontend-student/src/styles/apple-theme.css. */

page {
  background: #f5f5f7;
  color: #1d1d1f;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

view, text, scroll-view, form, input, button, textarea, picker {
  box-sizing: border-box;
}

button {
  line-height: 1.4;
  margin: 0;
}

button::after {
  border: 0;
}

.container {
  padding: 18rpx 36rpx calc(60rpx + env(safe-area-inset-bottom));
}

.home-page, .repair-page, .utility-page, .affair-page {
  padding-bottom: calc(165rpx + env(safe-area-inset-bottom));
}

.card {
  background: #fff;
  border: 0;
  border-radius: 40rpx;
  padding: 34rpx;
  margin-bottom: 26rpx;
  box-shadow: none;
}

.page-heading {
  padding: 12rpx 2rpx 36rpx;
}

.page-title {
  font-size: 54rpx;
  line-height: 1.24;
  font-weight: 600;
  letter-spacing: -1rpx;
  color: #1d1d1f;
}

.page-subtitle {
  margin-top: 12rpx;
  color: #76767d;
  font-size: 25rpx;
  line-height: 1.5;
}

.section-title {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 18rpx;
  margin-bottom: 26rpx;
}

.section-title .title-text {
  color: #1d1d1f;
  font-size: 32rpx;
  font-weight: 600;
}

.section-title .title-extra {
  color: #86868b;
  font-size: 22rpx;
  text-align: right;
}

.spring-btn {
  transition: transform 200ms cubic-bezier(.2,.7,.2,1), opacity 200ms ease, background-color 200ms ease;
}

.spring-btn:active {
  transform: scale(.975);
  opacity: .86;
}

.btn-primary, .btn-secondary {
  min-height: 88rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 18rpx 28rpx;
  border: 0;
  border-radius: 22rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  box-shadow: none;
}

button {
  max-width: none;
}

button.submit-btn, button.login-btn, button.save-btn, button.report-btn, button.unalloc-btn, button.toggle-btn, button.sheet-done, button.recharge-entry {
  width: 100% !important;
  max-width: none !important;
}

button.modal-cancel, button.modal-confirm {
  width: 0 !important;
  max-width: none !important;
}

.btn-primary {
  background: #006edb;
  color: #fff;
}

.btn-secondary {
  background: #f1f1f3;
  color: #1d1d1f;
}

button[disabled] {
  opacity: .5;
}

.badge {
  display: inline-flex;
  align-items: center;
  padding: 5rpx 14rpx;
  border-radius: 30rpx;
  font-size: 21rpx;
  font-weight: 500;
  white-space: nowrap;
}

.badge-blue {
  background: #edf4ff;
  color: #006edb;
}

.badge-green {
  background: #edf7f0;
  color: #287d4b;
}

.badge-amber {
  background: #fbf5e9;
  color: #9d650a;
}

.badge-red {
  background: #fff0ee;
  color: #c43832;
}

.badge-gray {
  background: #f5f5f7;
  color: #76767d;
}

.input-group {
  margin-bottom: 28rpx;
}

.input-label {
  display: block;
  color: #515154;
  font-size: 24rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.form-input, .form-textarea, .picker-input, .login-input, .custom-tag-input, .appeal-textarea, .rate-input-comment {
  width: 100%;
  background: #f5f5f7;
  color: #1d1d1f;
  border: 1rpx solid transparent;
  border-radius: 20rpx;
  font-size: 28rpx;
}

.form-input, .picker-input, .login-input {
  min-height: 88rpx;
  padding: 0 24rpx;
}

.form-textarea, .appeal-textarea, .rate-input-comment {
  height: 190rpx;
  min-height: 190rpx;
  padding: 22rpx 24rpx;
  line-height: 1.55;
}

.picker-input {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-arrow {
  color: #a1a1a6;
  font-size: 30rpx;
}

.empty-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 58rpx 30rpx;
}

.empty-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 16rpx;
  border-radius: 26rpx;
  background: #edf4ff;
  color: #006edb;
  font-size: 34rpx;
}

.empty-title {
  color: #1d1d1f;
  font-size: 29rpx;
  font-weight: 600;
}

.empty-text {
  color: #86868b;
  font-size: 24rpx;
  line-height: 1.6;
}

.shimmer {
  background: linear-gradient(90deg, #eeeef1 25%, #e5e5e9 50%, #eeeef1 75%);
  background-size: 200% 100%;
  animation: shimmerAnim 1.6s ease infinite;
}

@keyframes shimmerAnim {
  0% {
    background-position: 100% 50%;
  }
  100% {
    background-position: -100% 50%;
  }
}

.sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  background: rgba(0,0,0,.32);
  animation: maskIn 220ms ease both;
}

.sheet-mask-leave {
  animation: maskOut 220ms ease both;
}

.sheet-panel {
  width: 100%;
  max-height: 88vh;
  overflow: auto;
  background: #fff;
  border-radius: 36rpx 36rpx 0 0;
  padding: 18rpx 36rpx calc(36rpx + env(safe-area-inset-bottom));
  animation: sheetIn 280ms cubic-bezier(.2,.75,.25,1) both;
}

.sheet-panel-leave {
  animation: sheetOut 220ms ease both;
}

.sheet-grabber {
  width: 70rpx;
  height: 8rpx;
  border-radius: 10rpx;
  background: #d2d2d7;
  margin: 0 auto 28rpx;
}

.sheet-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.sheet-title {
  color: #1d1d1f;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.35;
}

.sheet-close {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: #f1f1f3;
  color: #6e6e73;
  font-size: 40rpx;
  line-height: 1;
}

@keyframes maskIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes maskOut {
  from {
    opacity: 1;
  }
  to {
    opacity: 0;
  }
}

@keyframes sheetIn {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

@keyframes sheetOut {
  from {
    transform: translateY(0);
  }
  to {
    transform: translateY(100%);
  }
}

@media (prefers-reduced-motion: reduce) {
  .spring-btn, .sheet-mask, .sheet-panel, .shimmer {
    transition-duration: .01ms;
    animation-duration: .01ms;
    animation-iteration-count: 1;
  }
}
