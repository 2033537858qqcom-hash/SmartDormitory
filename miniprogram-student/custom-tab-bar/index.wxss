.tab-bar {
  position: fixed;
  z-index: 100;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 8rpx;
  border: 1rpx solid rgba(232,232,237,.8);
  border-radius: 42rpx;
  background: rgba(255,255,255,.95);
  box-shadow: 0 8rpx 36rpx rgba(29,29,31,.08);
  backdrop-filter: blur(15px);
}

.tab-item {
  flex: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
  color: #76767d;
  font-size: 21rpx;
  transition: transform 200ms ease, opacity 200ms ease;
}

.tab-item:active {
  transform: scale(.96);
  opacity: .8;
}

.tab-selected {
  color: #006edb;
}

.tab-icon {
  width: 40rpx;
  height: 40rpx;
}

@media (prefers-reduced-motion: reduce) {
  .tab-item {
    transition-duration: .01ms;
  }
}

.tab-bar-dark { background: rgba(28,36,48,.96); border-color: #34404e; box-shadow: 0 8rpx 36rpx rgba(0,0,0,.24); }
.tab-bar-dark .tab-item { color: #a3b0bf; }
.tab-bar-dark .tab-selected { color: #77b5ff; }
.tab-bar-dark .tab-item:not(.tab-selected) .tab-icon { filter: invert(1); opacity: .75; }
