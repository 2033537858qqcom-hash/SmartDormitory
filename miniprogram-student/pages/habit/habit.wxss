.radar-card {
  padding: 32rpx 26rpx;
}

.radar-head {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: center;
  gap: 14rpx;
  padding: 0 4rpx 8rpx;
}

.radar-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--dark-text, #1d1d1f);
}

.radar-legend {
  display: flex;
  gap: 20rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 7rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.dot-mine {
  background: #006edb;
}

.dot-room {
  background: #60a58a;
}

.leg-text {
  color: var(--dark-muted-text, #86868b);
  font-size: 21rpx;
}

.canvas-box {
  width: 100%;
  height: 500rpx;
}

.radar-canvas {
  width: 100%;
  height: 100%;
}

.radar-summary {
  border-radius: 20rpx;
  background: var(--dark-canvas, #f5f5f7);
  padding: 18rpx 20rpx;
  margin-top: 6rpx;
}

.sum-text {
  color: var(--dark-secondary, #6e6e73);
  font-size: 23rpx;
  line-height: 1.6;
}

.dim-group {
  padding: 0 0 28rpx;
  margin-bottom: 28rpx;
  border-bottom: 1rpx solid #f0f0f2;
}

.dim-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 18rpx;
  margin-bottom: 16rpx;
}

.dim-title {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--dark-text, #1d1d1f);
}

.dim-curr-label {
  font-size: 23rpx;
  color: var(--dark-blue, #006edb);
  text-align: right;
}

.slider-ends {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  color: var(--dark-muted-text, #86868b);
  font-size: 21rpx;
}

.tag-section {
  margin: 8rpx 0 32rpx;
}

.tags-cloud {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 20rpx 0;
}

.tag-pill {
  padding: 11rpx 21rpx;
  border-radius: 40rpx;
  background: var(--dark-canvas, #f5f5f7);
  color: var(--dark-secondary, #6e6e73);
  font-size: 23rpx;
  border: 1rpx solid transparent;
}

.tag-active {
  background: var(--dark-blue-bg, #edf4ff);
  color: var(--dark-blue, #006edb);
  border-color: #d6e8fb;
}

.custom-tag-row {
  display: flex;
  gap: 14rpx;
}

.custom-tag-input {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  padding: 0 20rpx;
  font-size: 25rpx;
}

.add-tag-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 90rpx;
  padding: 0 20rpx;
  border-radius: 18rpx;
  background: var(--dark-blue-bg, #edf4ff);
  color: var(--dark-blue, #006edb);
  font-size: 24rpx;
  font-weight: 600;
}

.save-btn {
  width: 100%;
}

.retry-btn {
  margin-top: 24rpx;
}
