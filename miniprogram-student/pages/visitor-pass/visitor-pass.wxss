.pass-card {
  background: var(--dark-surface, #fff);
  border-radius: 40rpx;
  padding: 34rpx;
  margin-bottom: 26rpx;
}

.pass-header {
  display: flex;
  align-items: center;
}

.pass-badge {
  background: var(--dark-green-bg, #edf7f0);
  color: var(--dark-green, #287d4b);
  padding: 7rpx 16rpx;
  border-radius: 30rpx;
  font-size: 22rpx;
}

.qr-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 34rpx 0;
}

.qr-box {
  width: 320rpx;
  height: 320rpx;
  background: #fff;
}

.qr-canvas {
  width: 100%;
  height: 100%;
}

.passcode-text {
  color: var(--dark-text, #1d1d1f);
  font-size: 33rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
  margin-top: 16rpx;
  font-variant-numeric: tabular-nums;
}

.pass-meta {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: var(--dark-canvas, #f5f5f7);
}

.meta-item {
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.m-label {
  color: var(--dark-muted-text, #86868b);
  font-size: 21rpx;
}

.m-val {
  color: var(--dark-text, #1d1d1f);
  font-size: 25rpx;
  font-weight: 500;
  margin-top: 6rpx;
  overflow-wrap: anywhere;
}

.pass-tip {
  color: var(--dark-muted-text, #86868b);
  font-size: 22rpx;
  margin: 22rpx 0;
  line-height: 1.5;
}

.toggle-btn, .submit-btn {
  width: 100%;
}

.submit-btn {
  margin-top: 18rpx;
}

.retry-btn {
  margin-top: 24rpx;
}
