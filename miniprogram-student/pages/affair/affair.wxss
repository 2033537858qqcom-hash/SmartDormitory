.tab-segment {
  display: flex;
  gap: 4rpx;
  padding: 7rpx;
  background: #e9e9ec;
  border-radius: 22rpx;
  margin-bottom: 28rpx;
}

.seg-btn {
  flex: 1;
  padding: 16rpx 0;
  text-align: center;
  color: #76767d;
  font-size: 24rpx;
  font-weight: 500;
  border-radius: 16rpx;
}

.seg-active {
  color: #1d1d1f;
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,.07);
}

.civ-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.civ-title {
  display: block;
  color: #1d1d1f;
  font-size: 32rpx;
  font-weight: 600;
}

.civ-sub {
  display: block;
  margin-top: 6rpx;
  color: #86868b;
  font-size: 23rpx;
}

.star-badge {
  text-align: right;
}

.stars-text {
  color: #d49a27;
  font-size: 28rpx;
  letter-spacing: 2rpx;
}

.star-label {
  display: block;
  margin-top: 4rpx;
  color: #86868b;
  font-size: 21rpx;
}

.civ-scores {
  display: grid;
  grid-template-columns: repeat(2,1fr);
  margin: 28rpx 0 20rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #f7f7f9;
}

.score-col {
  display: flex;
  flex-direction: column;
  text-align: center;
}

.score-col + .score-col {
  border-left: 1rpx solid #e8e8ed;
}

.score-val {
  color: #1d1d1f;
  font-size: 36rpx;
  font-weight: 600;
}

.score-lbl {
  color: #86868b;
  font-size: 21rpx;
  margin-top: 4rpx;
}

.civ-tip {
  color: #86868b;
  font-size: 21rpx;
  line-height: 1.6;
}

.affair-grid {
  padding: 0 30rpx;
}

.affair-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 124rpx;
  padding: 22rpx 0;
}

.affair-item + .affair-item {
  border-top: 1rpx solid #eeeef0;
}

.af-icon {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  border-radius: 23rpx;
  background: #edf4ff;
}

.af-icon image {
  width: 40rpx;
  height: 40rpx;
}

.af-body {
  flex: 1;
  min-width: 0;
}

.af-name {
  font-size: 27rpx;
  color: #1d1d1f;
  font-weight: 600;
}

.af-desc {
  font-size: 22rpx;
  color: #86868b;
  margin-top: 5rpx;
  line-height: 1.4;
}

.af-arrow {
  color: #b6b6bc;
  font-size: 38rpx;
  line-height: 1;
}

.report-btn {
  width: 100%;
  margin-top: 16rpx;
}

.disc-item, .hist-item {
  padding: 23rpx 0;
  border-bottom: 1rpx solid #eeeef0;
}

.disc-item:last-child, .hist-item:last-child {
  border: 0;
  padding-bottom: 0;
}

.disc-head, .disc-footer, .hist-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 14rpx;
}

.disc-time, .hist-sub {
  color: #86868b;
  font-size: 22rpx;
}

.disc-desc, .hist-reason {
  color: #515154;
  font-size: 24rpx;
  line-height: 1.55;
  margin: 12rpx 0;
}

.disc-score {
  color: #76767d;
  font-size: 22rpx;
}

.appeal-btn {
  min-height: 58rpx;
  padding: 10rpx 20rpx;
  color: #006edb;
  background: #edf4ff;
  font-size: 22rpx;
  border-radius: 15rpx;
}

.hist-type {
  font-size: 27rpx;
  font-weight: 600;
}

.hist-sub {
  margin-top: 8rpx;
}

.hist-reply {
  font-size: 22rpx;
  color: #287d4b;
  margin-top: 8rpx;
}

.modal-sub {
  margin: 16rpx 0 24rpx;
  color: #86868b;
  font-size: 24rpx;
}

.appeal-textarea {
  margin-bottom: 24rpx;
}

.modal-actions {
  display: flex;
  gap: 16rpx;
}

.modal-cancel, .modal-confirm {
  flex: 1;
}

.retry-btn {
  margin-top: 24rpx;
}
