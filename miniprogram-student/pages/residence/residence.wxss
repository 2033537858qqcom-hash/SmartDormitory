.type-segment {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.type-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 82rpx;
  border: 2rpx solid transparent;
  border-radius: 20rpx;
  background: #f5f5f7;
  color: #515154;
  font-size: 25rpx;
}

.type-act {
  color: #006edb;
  background: #edf4ff;
  border-color: #006edb;
  font-weight: 600;
}

.date-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.date-col {
  min-width: 0;
}

.picker-input {
  font-size: 24rpx;
}

.submit-btn {
  width: 100%;
  margin-top: 16rpx;
}

.req-item {
  padding: 22rpx 0;
  border-bottom: 1rpx solid #eeeef0;
}

.req-item:last-child {
  border: 0;
  padding-bottom: 0;
}

.req-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
}

.req-type {
  font-size: 27rpx;
  font-weight: 600;
}

.req-dates {
  color: #006edb;
  font-size: 22rpx;
  margin-top: 10rpx;
}

.req-reason {
  color: #6e6e73;
  font-size: 24rpx;
  line-height: 1.6;
  margin-top: 10rpx;
}

.req-reply {
  color: #287d4b;
  background: #edf7f0;
  font-size: 22rpx;
  padding: 14rpx 18rpx;
  border-radius: 16rpx;
  margin-top: 12rpx;
}

.records-empty {
  text-align: center;
  padding: 20rpx 0;
}
