.repair-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 32rpx;
}

.hero-copy {
  flex: 1;
  min-width: 0;
}

.hero-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--dark-text, #1d1d1f);
}

.hero-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--dark-muted-text, #86868b);
}

.hero-action, .empty-action {
  flex: none;
  width: auto !important;
  background: #006edb;
  color: #fff;
  border-radius: 19rpx;
  font-size: 24rpx;
  font-weight: 600;
  min-height: 70rpx;
  padding: 18rpx 24rpx;
  white-space: nowrap;
}

.empty-action {
  margin-top: 24rpx;
  background: var(--dark-blue-bg, #edf4ff);
  color: var(--dark-blue, #006edb);
}

.repair-reminder {
  color: #8d631a;
  background: var(--dark-amber-bg, #fbf5e9);
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  font-size: 23rpx;
  margin-bottom: 24rpx;
}

.list-heading {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin: 36rpx 4rpx 18rpx;
  font-size: 31rpx;
  font-weight: 600;
}

.list-heading text + text {
  color: var(--dark-muted-text, #86868b);
  font-size: 22rpx;
  font-weight: 400;
}

.empty-box .empty-text {
  margin-top: 10rpx;
  max-width: 440rpx;
}

.order-card {
  padding: 30rpx 32rpx;
}

.order-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}

.order-no {
  font-size: 22rpx;
  color: var(--dark-muted-text, #86868b);
}

.order-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.order-title {
  color: var(--dark-text, #1d1d1f);
  font-size: 31rpx;
  font-weight: 600;
  line-height: 1.4;
}

.order-desc {
  color: var(--dark-secondary, #6e6e73);
  font-size: 24rpx;
  line-height: 1.6;
  margin-top: 12rpx;
}

.order-meta-info {
  background: var(--dark-muted, #f7f7f9);
  border-radius: 20rpx;
  padding: 18rpx 20rpx;
  margin-top: 24rpx;
  font-size: 23rpx;
}

.meta-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.meta-row:last-child {
  margin: 0;
}

.meta-label {
  color: var(--dark-muted-text, #86868b);
}

.meta-val {
  color: var(--dark-secondary, #515154);
}

.sla-overdue {
  color: var(--dark-red, #c43832);
}

.order-photos {
  display: flex;
  gap: 12rpx;
  margin-top: 20rpx;
}

.order-thumb {
  width: 130rpx;
  height: 130rpx;
  border-radius: 16rpx;
}

.rating-box {
  margin-top: 22rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #eeeef0;
}

.unrated-prompt {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.prompt-text {
  color: var(--dark-muted-text, #76767d);
  font-size: 23rpx;
}

.rate-act-btn {
  min-height: 64rpx;
  font-size: 23rpx;
  padding: 12rpx 22rpx;
  border-radius: 16rpx;
}

.rated-display {
  font-size: 23rpx;
  color: var(--dark-muted-text, #76767d);
}

.star-row {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.star-icon {
  color: #c78d23;
  font-size: 28rpx;
}

.rate-num {
  margin-left: 8rpx;
}

.rate-comment {
  margin-top: 8rpx;
}

.repair-form-scroll {
  max-height: 67vh;
  margin-top: 26rpx;
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
}

.cat-item {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 80rpx;
  background: var(--dark-canvas, #f5f5f7);
  border: 2rpx solid transparent;
  border-radius: 20rpx;
  color: var(--dark-secondary, #515154);
}

.cat-active {
  background: var(--dark-blue-bg, #edf4ff);
  border-color: var(--dark-blue, #006edb);
  color: var(--dark-blue, #006edb);
}

.cat-name {
  font-size: 25rpx;
  font-weight: 500;
}

.priority-alert {
  margin-top: 12rpx;
  padding: 16rpx 20rpx;
  border-radius: 18rpx;
  color: var(--dark-amber, #9d650a);
  background: var(--dark-amber-bg, #fbf5e9);
  font-size: 22rpx;
  line-height: 1.6;
}

.photo-list {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.photo-item, .upload-btn {
  position: relative;
  width: 146rpx;
  height: 146rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

.photo-img {
  width: 100%;
  height: 100%;
}

.del-photo {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 38rpx;
  height: 38rpx;
  line-height: 35rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(0,0,0,.6);
  color: #fff;
  font-size: 28rpx;
}

.upload-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  background: var(--dark-canvas, #f5f5f7);
  color: var(--dark-muted-text, #86868b);
}

.upload-plus {
  font-size: 42rpx;
  line-height: 1;
}

.upload-text {
  font-size: 21rpx;
  margin-top: 8rpx;
}

.submit-btn {
  width: 100%;
  margin: 20rpx 0 6rpx;
}

.modal-sub {
  margin: 14rpx 0 28rpx;
  color: var(--dark-muted-text, #86868b);
  font-size: 24rpx;
}

.star-selector {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin: 18rpx 0 8rpx;
}

.modal-star {
  color: #d2d2d7;
  font-size: 64rpx;
}

.modal-star-act {
  color: #e5a529;
}

.star-hint-text {
  text-align: center;
  color: var(--dark-muted-text, #76767d);
  font-size: 23rpx;
  margin-bottom: 24rpx;
}

.rate-input-comment {
  margin-bottom: 24rpx;
}

.modal-actions {
  display: flex;
  gap: 16rpx;
}

.modal-cancel, .modal-confirm {
  flex: 1;
}
