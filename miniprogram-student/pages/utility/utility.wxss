.demo-note {
  margin: -8rpx 0 26rpx;
  padding: 17rpx 22rpx;
  border-radius: 18rpx;
  background: var(--dark-muted, #eeeef1);
  color: var(--dark-muted-text, #76767d);
  font-size: 22rpx;
}

.balance-card {
  padding: 32rpx;
}

.balance-top {
  display: flex;
  justify-content: space-between;
  color: var(--dark-text, #1d1d1f);
  font-size: 27rpx;
  font-weight: 600;
}

.balance-top text + text {
  color: #a1a1a6;
  font-size: 21rpx;
  font-weight: 400;
}

.accounts-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  margin: 34rpx 0;
}

.account {
  min-width: 0;
}

.account + .account {
  border-left: 1rpx solid #eeeef0;
  padding-left: 30rpx;
}

.account-label {
  color: var(--dark-muted-text, #86868b);
  font-size: 23rpx;
}

.account-value {
  color: var(--dark-text, #1d1d1f);
  font-size: 40rpx;
  font-weight: 600;
  margin: 8rpx 0 4rpx;
  font-variant-numeric: tabular-nums;
}

.value-low {
  color: var(--dark-red, #c43832);
}

.account-hint {
  color: #a1a1a6;
  font-size: 21rpx;
}

.low-balance, .abnormal-warn {
  padding: 16rpx 20rpx;
  border-radius: 18rpx;
  background: var(--dark-amber-bg, #fbf5e9);
  color: var(--dark-amber, #9d650a);
  font-size: 22rpx;
  line-height: 1.5;
  margin-bottom: 20rpx;
}

.recharge-entry {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 14rpx;
  width: 100%;
  min-height: 80rpx;
  padding: 12rpx 20rpx;
  border-radius: 20rpx;
  background: var(--dark-blue-bg, #edf4ff);
  color: var(--dark-blue, #006edb);
  font-size: 25rpx;
  font-weight: 600;
}

.recharge-entry image {
  width: 34rpx;
  height: 34rpx;
}

.entry-arrow {
  margin-left: auto;
  font-size: 36rpx;
  color: #8eb9e6;
}

.list-heading {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin: 38rpx 4rpx 18rpx;
  color: var(--dark-text, #1d1d1f);
  font-size: 31rpx;
  font-weight: 600;
}

.list-heading text + text {
  color: var(--dark-muted-text, #86868b);
  font-size: 22rpx;
  font-weight: 400;
}

.empty-box .empty-text {
  margin-top: 10rpx;
}

.retry-action {
  margin-top: 20rpx;
  padding: 12rpx 22rpx;
  color: var(--dark-blue, #006edb);
  background: var(--dark-blue-bg, #edf4ff);
  border-radius: 16rpx;
  font-size: 24rpx;
}

.bill-card {
  padding: 30rpx 32rpx;
}

.bill-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.bill-month {
  font-size: 28rpx;
  color: var(--dark-text, #1d1d1f);
  font-weight: 600;
}

.abnormal-warn {
  margin: 20rpx 0 0;
}

.bill-lines {
  margin: 24rpx 0;
  color: var(--dark-secondary, #515154);
  font-size: 24rpx;
}

.bill-lines view {
  display: flex;
  justify-content: space-between;
  padding: 7rpx 0;
}

.bill-lines view text:first-child {
  color: var(--dark-muted-text, #86868b);
}

.bill-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  border-top: 1rpx solid #eeeef0;
  padding-top: 22rpx;
}

.bill-total-label {
  color: var(--dark-muted-text, #86868b);
  font-size: 22rpx;
  margin-right: 14rpx;
}

.bill-total {
  color: var(--dark-text, #1d1d1f);
  font-size: 30rpx;
  font-weight: 600;
}

.pay-btn {
  background: var(--dark-blue-bg, #edf4ff);
  color: var(--dark-blue, #006edb);
  border-radius: 16rpx;
  padding: 14rpx 20rpx;
  font-size: 23rpx;
  font-weight: 600;
}

.logs-card {
  padding: 0 30rpx;
}

.log-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
}

.log-item + .log-item {
  border-top: 1rpx solid #eeeef0;
}

.log-main {
  flex: 1;
  min-width: 0;
}

.log-title {
  font-size: 26rpx;
  font-weight: 600;
}

.log-meta {
  color: var(--dark-muted-text, #86868b);
  font-size: 20rpx;
  margin-top: 6rpx;
  overflow-wrap: anywhere;
}

.log-amount {
  text-align: right;
  color: var(--dark-secondary, #515154);
  font-size: 22rpx;
}

.sheet-note {
  color: var(--dark-muted-text, #76767d);
  font-size: 23rpx;
  margin: 14rpx 0 30rpx;
}

.target-selector, .amount-grid {
  display: grid;
  gap: 14rpx;
}

.target-selector {
  grid-template-columns: repeat(2, 1fr);
}

.amount-grid {
  grid-template-columns: repeat(4, 1fr);
}

.target-item, .amount-pill {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 82rpx;
  border: 2rpx solid transparent;
  border-radius: 18rpx;
  background: var(--dark-canvas, #f5f5f7);
  color: var(--dark-secondary, #515154);
  font-size: 25rpx;
}

.target-act, .pill-act {
  background: var(--dark-blue-bg, #edf4ff);
  border-color: var(--dark-blue, #006edb);
  color: var(--dark-blue, #006edb);
  font-weight: 600;
}

.recharge-btn {
  width: 100% !important;
  max-width: none !important;
  margin-top: 30rpx;
}
