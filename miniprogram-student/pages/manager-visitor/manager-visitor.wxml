<view class="manager-page container">
  <view class="manager-header">
    <view><view class="eyebrow">宿管工作台</view><view class="page-title">访客核验</view><view class="page-subtitle">{{name}}，扫描学生出示的访客通行码。</view></view>
    <button class="logout spring-btn" bindtap="handleLogout">退出</button>
  </view>

  <view class="scan-card card">
    <view class="scan-icon"><image src="/images/ui/visitor.png" mode="aspectFit" /></view>
    <view class="scan-title">扫描通行码</view>
    <view class="scan-description">核验后查看来访信息，访客离开时确认签离。</view>
    <button class="btn-primary spring-btn scan-button" loading="{{scanning || busy}}" disabled="{{scanning || busy || confirming}}" bindtap="scanPass">打开相机扫码</button>
  </view>

  <view class="manual-card card">
    <view class="manual-title">手动输入通行码</view>
    <view class="manual-row">
      <input class="form-input manual-input" placeholder="例如 VP-802101" value="{{code}}" disabled="{{busy || scanning || confirming}}" bindinput="onCodeInput" confirm-type="search" bindconfirm="verifyInput" />
      <button class="btn-secondary spring-btn verify-button" disabled="{{busy || scanning || confirming}}" bindtap="verifyInput">核验</button>
    </view>
  </view>

  <view wx:if="{{result}}" class="result-card card">
    <view class="result-heading"><view><view class="result-label">核验结果</view><view class="result-code">{{result.passCode}}</view></view><text class="badge {{result.status === 1 ? 'badge-gray' : (result.overstayFlag === 1 ? 'badge-amber' : (result.passOk ? 'badge-green' : 'badge-red'))}}">{{result.status === 1 ? '已签离' : (result.overstayFlag === 1 ? '在访超时' : (result.passOk ? '在访中' : '需复核'))}}</text></view>
    <view class="result-message">{{resultMessage}}</view>
    <view class="detail-row"><text>访客</text><text>{{result.visitorName || '—'}}{{result.relation ? ' · ' + result.relation : ''}}</text></view>
    <view class="detail-row"><text>被访学生</text><text>{{result.visitStudentName || '—'}}</text></view>
    <view class="detail-row"><text>楼栋房间</text><text>{{result.buildingName || '—'}} {{result.roomNo || ''}}</text></view>
    <view class="detail-row"><text>登记时间</text><text>{{result.enterTimeText || '—'}}</text></view>
    <view class="detail-row"><text>在访时长</text><text>{{result.stayMinutes || 0}} 分钟</text></view>
    <view wx:if="{{result.status === 1}}" class="detail-row"><text>签离时间</text><text>{{result.leaveTimeText || '—'}}</text></view>
    <button wx:if="{{result.passOk}}" class="btn-primary spring-btn checkout-button" loading="{{busy}}" disabled="{{busy || confirming}}" bindtap="confirmCheckOut">确认访客签离</button>
  </view>
  <view class="footnote">仅可核验您管辖楼栋的访客。扫码核验不会自动签离。</view>
</view>
