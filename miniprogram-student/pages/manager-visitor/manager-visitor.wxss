.manager-page { padding-top: 38rpx; }
.manager-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 20rpx; margin-bottom: 38rpx; }
.eyebrow { color: #006edb; font-size: 23rpx; font-weight: 600; margin-bottom: 10rpx; }
.logout { flex: none; background: #e9e9ed; color: #515154; border-radius: 30rpx; font-size: 23rpx; padding: 12rpx 22rpx; }
.scan-card { padding: 40rpx; }
.scan-icon { display: flex; align-items: center; justify-content: center; width: 84rpx; height: 84rpx; background: #edf4ff; border-radius: 25rpx; margin-bottom: 24rpx; }
.scan-icon image { width: 44rpx; height: 44rpx; }
.scan-title { font-size: 36rpx; font-weight: 600; }
.scan-description { color: #76767d; font-size: 25rpx; margin-top: 10rpx; line-height: 1.6; }
.scan-button { width: 100%; margin-top: 32rpx; }
.manual-title { font-size: 27rpx; font-weight: 600; margin-bottom: 20rpx; }
.manual-row { display: flex; gap: 16rpx; align-items: center; }
.manual-input { flex: 1; min-width: 0; }
.verify-button { flex: none; min-height: 88rpx; padding: 18rpx 28rpx; }
.result-heading { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.result-label { font-size: 23rpx; color: #76767d; }
.result-code { font-size: 34rpx; font-weight: 600; margin-top: 4rpx; }
.result-message { color: #515154; font-size: 24rpx; margin: 20rpx 0; }
.detail-row { display: flex; justify-content: space-between; gap: 24rpx; padding: 18rpx 0; border-top: 1rpx solid #eeeef0; font-size: 25rpx; }
.detail-row text:first-child { color: #86868b; flex: none; }
.detail-row text:last-child { text-align: right; color: #1d1d1f; }
.checkout-button { width: 100%; margin-top: 25rpx; }
.footnote { color: #86868b; font-size: 23rpx; line-height: 1.6; margin: 8rpx 4rpx; }
