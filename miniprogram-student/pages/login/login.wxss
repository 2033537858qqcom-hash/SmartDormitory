.login-page {
  min-height: 100vh;
  padding: 40rpx 36rpx calc(50rpx + env(safe-area-inset-bottom));
}

/* 顶部校园实景封面卡片 */
.login-cover-banner {
  position: relative;
  width: 100%;
  height: 310rpx;
  border-radius: 32rpx;
  overflow: hidden;
  margin-bottom: 32rpx;
  box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.08);
}

.cover-photo {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.cover-gradient-mask {
  position: relative;
  z-index: 2;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  padding: 28rpx 32rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  background: linear-gradient(
    155deg,
    rgba(15, 23, 42, 0.45) 0%,
    rgba(15, 23, 42, 0.85) 100%
  );
  backdrop-filter: blur(2px);
}

.cover-badge {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.logo-circle {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 82rpx;
  height: 82rpx;
  border-radius: 22rpx;
  overflow: hidden;
  background: #ffffff;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.18);
  flex-shrink: 0;
}

.logo-image {
  width: 100%;
  height: 100%;
}

.cover-badge-texts {
  display: flex;
  flex-direction: column;
}

.brand-title {
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: -0.5rpx;
}

.brand-tag {
  color: rgba(255, 255, 255, 0.72);
  font-size: 20rpx;
  letter-spacing: 1rpx;
  margin-top: 2rpx;
}

.brand-sub {
  color: rgba(255, 255, 255, 0.88);
  font-size: 23rpx;
  line-height: 1.45;
}

.login-card {
  padding: 36rpx;
}

.card-title {
  color: #1d1d1f;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 30rpx;
}

.login-btn {
  width: 100%;
  margin-top: 38rpx;
}

.demo-section {
  margin-top: 42rpx;
}

.demo-title {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin: 0 4rpx 18rpx;
}

.demo-title-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #1d1d1f;
}

.demo-title-note {
  font-size: 22rpx;
  color: #86868b;
}

.demo-grid {
  overflow: hidden;
  border-radius: 36rpx;
  background: #fff;
  padding: 0 28rpx;
}

.demo-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 86rpx;
  padding: 18rpx 0;
}

.demo-item + .demo-item {
  border-top: 1rpx solid #eeeef0;
}

.demo-name {
  color: #1d1d1f;
  font-size: 25rpx;
  font-weight: 500;
  white-space: nowrap;
}

.demo-meta {
  color: #86868b;
  font-size: 21rpx;
  text-align: right;
}

.demo-item.active .demo-name {
  color: #006edb;
}
