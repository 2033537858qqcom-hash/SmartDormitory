.login-page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background: #122338;
}

.login-background {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  overflow: hidden;
}

.cover-photo, .cover-gradient-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.cover-gradient-mask {
  background: linear-gradient(180deg, rgba(13, 29, 48, .55) 0%, rgba(13, 29, 48, .32) 42%, rgba(13, 29, 48, .76) 100%);
}

.login-content {
  position: relative;
  z-index: 1;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 40rpx 36rpx calc(24rpx + env(safe-area-inset-bottom));
}

.brand-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.brand-logo {
  width: 70rpx;
  height: 70rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.brand-copy { color: #fff; }
.brand-title { font-size: 31rpx; line-height: 1.2; font-weight: 700; }
.brand-tag { margin-top: 5rpx; color: rgba(255, 255, 255, .76); font-size: 20rpx; letter-spacing: 1rpx; }

.welcome {
  padding: 54rpx 4rpx 32rpx;
  color: #fff;
}

.welcome-title { font-size: 48rpx; font-weight: 700; line-height: 1.25; letter-spacing: 1rpx; }
.welcome-subtitle { margin-top: 12rpx; font-size: 24rpx; color: rgba(255, 255, 255, .82); }

.login-panel {
  padding: 36rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, .97);
  box-shadow: 0 20rpx 60rpx rgba(5, 20, 40, .16);
}

.panel-heading { margin-bottom: 30rpx; }
.panel-title { font-size: 34rpx; line-height: 1.25; color: var(--dark-text, #1c2735); font-weight: 700; }
.panel-subtitle { margin-top: 8rpx; color: var(--dark-muted-text, #858e99); font-size: 22rpx; }
.login-field { margin-bottom: 22rpx; }
.field-label { display: block; margin-bottom: 10rpx; color: var(--dark-secondary, #44505e); font-size: 23rpx; font-weight: 600; }
.login-input { min-height: 82rpx; padding: 0 22rpx; background: var(--dark-muted, #f3f5f8); border-radius: 16rpx; font-size: 27rpx; }
.input-placeholder { color: #a3abb5; }

button.login-btn {
  min-height: 86rpx;
  margin-top: 30rpx;
  border-radius: 17rpx;
  background: #176ee5;
  box-shadow: 0 8rpx 20rpx rgba(23, 110, 229, .2);
}

.demo-section { margin-top: 32rpx; padding-top: 26rpx; border-top: 1rpx solid #edf0f4; }
.demo-heading { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 16rpx; }
.demo-title { color: var(--dark-secondary, #44505e); font-size: 23rpx; font-weight: 600; }
.demo-note { color: #a0a8b2; font-size: 20rpx; }
.demo-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10rpx; }
.demo-item {
  min-width: 0;
  padding: 13rpx 12rpx;
  border: 1rpx solid #e9edf2;
  border-radius: 14rpx;
  background: var(--dark-muted, #f8f9fb);
}
.demo-item.active { border-color: #95bcf5; background: var(--dark-blue-bg, #edf5ff); }
.demo-name { overflow: hidden; color: var(--dark-text, #3e4a59); font-size: 22rpx; font-weight: 600; white-space: nowrap; text-overflow: ellipsis; }
.demo-item.active .demo-name { color: var(--dark-blue, #176ee5); }
.demo-meta { margin-top: 3rpx; overflow: hidden; color: var(--dark-muted-text, #939eaa); font-size: 19rpx; white-space: nowrap; text-overflow: ellipsis; }
.login-footnote { margin-top: auto; padding: 28rpx 0 0; color: rgba(255, 255, 255, .7); text-align: center; font-size: 20rpx; letter-spacing: 1rpx; }

.login-theme-control { margin-left: auto; order: 3; background: rgba(255,255,255,.16); color: #fff; border-color: rgba(255,255,255,.3); }
.theme-dark .login-panel { background: rgba(28,36,48,.97); }
.theme-dark .demo-item { border-color: #34404e; }
.theme-dark .login-input { border-color: transparent; }
